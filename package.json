{
  "name": "dripwriter-origin",
  "displayName": "Dripwriter Origin",
  "version": "3.1.0",
  "description": "Simulates human typing on any website — Google Docs, Canvas, and more: natural speed, realistic typos, false starts, and breaks.",
  "author": "Alexey Fedorov",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "plasmo dev",
    "dev:firefox": "plasmo dev --target=firefox-mv3",
    "build": "plasmo build && node scripts/fix-manifest.js chrome",
    "build:firefox": "plasmo build --target=firefox-mv3 && node scripts/fix-manifest.js firefox",
    "package": "plasmo package && node scripts/fix-manifest.js chrome && plasmo package --target=firefox-mv3 && node scripts/fix-manifest.js firefox",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.ts\"",
    "test:integration": "node --test --test-concurrency=1 \"tests/integration/*.test.mjs\"",
    "test:all": "pnpm test && pnpm test:integration"
  },
  "dependencies": {
    "plasmo": "0.90.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.9",
    "@types/node": "^26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "typescript": "^6.0.3"
  },
  "manifest": {
    "name": "Dripwriter Origin",
    "permissions": [
      "storage",
      "scripting"
    ],
    "host_permissions": [
      "<all_urls>"
    ],
    "browser_specific_settings": {
      "gecko": {
        "id": "dripwriter-origin@local.extension",
        "data_collection_permissions": {
          "required": [
            "none"
          ]
        }
      }
    }
  }
}
