{
  "name": "dripwriter-origin",
  "displayName": "Dripwriter Origin",
  "version": "2.1.1",
  "description": "Simulates human typing in Google Docs: natural speed, realistic typos, false starts, and breaks.",
  "author": "Alexey Fedorov",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "plasmo dev",
    "dev:firefox": "plasmo dev --target=firefox-mv3",
    "build": "plasmo build",
    "build:firefox": "plasmo build --target=firefox-mv3",
    "package": "plasmo package && plasmo package --target=firefox-mv3",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "plasmo": "0.90.5",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.0",
    "@types/node": "^26.0.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "typescript": "^6.0.3"
  },
  "manifest": {
    "name": "Dripwriter Origin",
    "permissions": [
      "storage",
      "tabs"
    ],
    "host_permissions": [
      "https://docs.google.com/*"
    ],
    "browser_specific_settings": {
      "gecko": {
        "id": "dripwriter-origin@local.extension",
        "data_collection_permissions": {
          "required": [
            "none"
          ]
        }
      }
    }
  }
}
